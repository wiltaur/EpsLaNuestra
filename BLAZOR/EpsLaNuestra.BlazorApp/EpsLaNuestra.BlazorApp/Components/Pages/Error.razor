@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Se ha producido un error al procesar su solicitud.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Id de solicitud:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de Desarrollo</h3>
<p>
    Cambiar al entorno de <strong>Desarrollo</strong> mostrará información más detallada sobre el error ocurrido.
</p>
<p>
    <strong>El entorno de desarrollo no debe estar habilitado para las aplicaciones desplegadas.</strong>
    Puede dar lugar a que se muestre información confidencial proveniente de excepciones a los usuarios finales.
    Para compilación Local, habilite las variables de entorno de <strong>Desarrollo</strong>
    y reinicie la aplicación.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}